{
  "info": {
    "name": "Fundsroom Mini ERP & CRM API Collection",
    "_postman_id": "fundsroom-erp-api-v1",
    "description": "Complete REST API collection for Mini ERP + CRM Operations Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fundsroom.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Customer CRM",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers?search=&customerType=&status=",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apex Logistics\",\n  \"companyName\": \"Apex Corp\",\n  \"email\": \"contact@apex.com\",\n  \"phone\": \"+91 9876543210\",\n  \"address\": \"42 Hub, Mumbai\",\n  \"customerType\": \"WHOLESALER\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Add Customer Follow-up Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Discussed Q3 pricing requirements.\",\n  \"followUpDate\": \"2026-08-15T10:00:00.000Z\",\n  \"status\": \"PENDING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/:id/follow-ups",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":id", "follow-ups"]
            }
          }
        }
      ]
    },
    {
      "name": "Products & Inventory",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?search=&category=&lowStockOnly=false",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get Low Stock Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/low-stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", "low-stock"]
            }
          }
        },
        {
          "name": "Manual Stock IN/OUT Movement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"IN\",\n  \"quantity\": 20,\n  \"remarks\": \"Restock shipment from supplier #881\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:id/stock-movement",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id", "stock-movement"]
            }
          }
        }
      ]
    },
    {
      "name": "Sales Challan",
      "item": [
        {
          "name": "Create Draft Sales Challan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"<CUSTOMER_UUID>\",\n  \"notes\": \"Urgent warehouse dispatch\",\n  \"items\": [\n    {\n      \"productId\": \"<PRODUCT_UUID>\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales-challans",
              "host": ["{{baseUrl}}"],
              "path": ["sales-challans"]
            }
          }
        },
        {
          "name": "Confirm Sales Challan (Deduct Stock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-challans/:id/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["sales-challans", ":id", "confirm"]
            }
          }
        },
        {
          "name": "Cancel Sales Challan (Restore Stock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-challans/:id/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["sales-challans", ":id", "cancel"]
            }
          }
        }
      ]
    }
  ]
}
